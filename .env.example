# Supabase Configuration
# Required: The URL and public anonymous key of your Supabase project.
# Find these in your Supabase project dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: Service role key for admin scripts or server-side background tasks (keep strictly confidential!)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider Configuration
# Options: "gemini" (recommended), "mock" (default, deterministic fallback)
AI_PROVIDER_TYPE="mock"
GEMINI_API_KEY="your-gemini-api-key"
# AI_API_KEY="your-gemini-or-openai-api-key"

# Application URL for redirects and authentication callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email OAuth Configuration (Planned production integration)
# GMAIL_CLIENT_ID="your-google-client-id"
# GMAIL_CLIENT_SECRET="your-google-client-secret"
